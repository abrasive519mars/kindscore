# ── Supabase ─────────────────────────────────────────────────────────────────
# Project → Settings → API. Use a NEW project (PRD §15.1), region ap-south-1.
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Server-only. Never expose with NEXT_PUBLIC_. Used by the Stripe webhook and scripts/seed.ts.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Stripe (test mode) ───────────────────────────────────────────────────────
# Developers → API keys
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Developers → Webhooks → endpoint https://<app>/api/stripe/webhook (or `pnpm stripe:listen` locally)
STRIPE_WEBHOOK_SECRET=whsec_...
# Products → prices for "Kindscore Monthly" ₹499 and "Kindscore Yearly" ₹4,999 (INR)
STRIPE_PRICE_MONTHLY=price_...
STRIPE_PRICE_YEARLY=price_...

# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Random string; Vercel cron sends it as a bearer token to /api/cron/keepalive
CRON_SECRET=change-me
# Password given to every seeded account by scripts/seed.ts
SEED_PASSWORD=Kindscore!2026
