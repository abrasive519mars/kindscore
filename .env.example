# ── Supabase ─────────────────────────────────────────────────────────────────
# Project → Settings → API. Use a NEW project (PRD §15.1), region ap-south-1.
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Server-only. Never expose with NEXT_PUBLIC_. Used by the Stripe webhook and scripts/seed.ts.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Stripe (test mode) ───────────────────────────────────────────────────────
# Developers → API keys
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# `pnpm stripe:setup --webhook https://<app>` prints it (or `pnpm stripe:listen` locally).
# Locally any `whsec_` placeholder works: the success page syncs without a webhook.
STRIPE_WEBHOOK_SECRET=whsec_...
# `pnpm stripe:setup` prints both (product "Kindscore membership", ₹499/month and ₹4,999/year, INR)
STRIPE_PRICE_MONTHLY=price_...
STRIPE_PRICE_YEARLY=price_...

# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Random string; Vercel cron sends it as a bearer token to /api/cron/keepalive
CRON_SECRET=change-me
# Password given to every seeded account by scripts/seed.ts
SEED_PASSWORD=Kindscore!2026
# "1" shows the demo-accounts panel on /login?demo=1 and the "Try a demo account" link (evaluator deployments)
NEXT_PUBLIC_DEMO_ACCOUNTS=1
